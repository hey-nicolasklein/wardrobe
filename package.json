{
  "name": "wardrobe-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "services:up": "docker compose up -d --wait postgres object-storage",
    "services:down": "docker compose down",
    "services:migrate": "node --env-file=.env.services.local --import tsx packages/service/src/cli/migrate.ts",
    "accounts:create": "node --env-file=.env.services.local --import tsx packages/service/src/cli/create-account.ts",
    "fixtures:reset": "node --env-file=.env.services.local --import tsx packages/service/src/cli/reset-fixtures.ts",
    "test:integration": "FORM_RUN_SERVICE_INTEGRATION=true node --env-file=.env.services.local --import tsx --test --test-concurrency=1 packages/service/src/integration.test.ts apps/api/src/integration.test.ts apps/api/src/personal.test.ts",
    "test:openai-smoke": "FORM_RUN_OPENAI_SMOKE=true node --import tsx --test packages/service/src/openai-smoke.test.ts",
    "test:browser-smoke": "playwright test",
    "dev:production": "concurrently -n api,worker,web -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "node --env-file=apps/api/.env.local --import tsx node_modules/tsx/dist/cli.mjs watch --include 'packages/**/src/**' apps/api/src/index.ts",
    "dev:worker": "node --env-file=apps/worker/.env.local --import tsx node_modules/tsx/dist/cli.mjs watch --include 'packages/**/src/**' apps/worker/src/index.ts",
    "dev:web": "node --env-file=apps/api/.env.local --import tsx apps/web/dev.mjs",
    "verify": "npm run verify --workspaces --if-present",
    "verify:mobile": "bash apps/mobile/tool/verify.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.0"
  }
}
