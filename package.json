{
  "name": "wardrobe-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "services:up": "docker compose up -d --wait postgres object-storage",
    "services:down": "docker compose down",
    "services:migrate": "node --env-file=.env.services.local --import tsx packages/service/src/cli/migrate.ts",
    "accounts:create": "node --env-file=.env.services.local --import tsx packages/service/src/cli/create-account.ts",
    "fixtures:reset": "node --env-file=.env.services.local --import tsx packages/service/src/cli/reset-fixtures.ts",
    "test:integration": "FORM_RUN_SERVICE_INTEGRATION=true node --env-file=.env.services.local --import tsx --test --test-concurrency=1 packages/service/src/integration.test.ts apps/api/src/integration.test.ts",
    "test:openai-smoke": "FORM_RUN_OPENAI_SMOKE=true node --import tsx --test packages/service/src/openai-smoke.test.ts",
    "dev:production": "concurrently -n api,worker,mobile -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:mobile\"",
    "dev:api": "npm run dev --workspace=@form/api",
    "dev:worker": "npm run dev --workspace=@form/worker",
    "dev:mobile": "npm run start --workspace=@form/mobile",
    "verify": "npm run verify --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
