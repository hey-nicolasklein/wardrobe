# Host path on the NAS. Keep this outside the repository and back it up.
FORM_DATA_DIR=/volume1/docker/form
# Loopback port used by Tailscale Serve. Change it if another NAS service owns 8081.
FORM_WEB_PORT=8081

POSTGRES_DB=form
POSTGRES_USER=form
POSTGRES_PASSWORD=replace-with-a-long-random-password

# MinIO credentials. The API and worker use these to access private media.
S3_ACCESS_KEY_ID=form-production
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_REGION=us-east-1
S3_BUCKET=form-private-media
S3_FORCE_PATH_STYLE=true
# The Tailscale origin also proxies /form-private-media/ to MinIO for signed browser media.
S3_PUBLIC_ENDPOINT=https://wardrobe.your-tailnet.ts.net

# Public Tailscale HTTPS origin used for browser CORS, cookies, and the mobile web build.
PUBLIC_WEB_ORIGIN=https://wardrobe.your-tailnet.ts.net
WEB_ORIGIN=https://wardrobe.your-tailnet.ts.net

SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=replace-me
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_DETECTION_MODEL=gpt-5.4-mini
OPENAI_PRICING_EFFECTIVE_DATE=2026-08-19
OPENAI_IMAGE_TEXT_INPUT_RATE_MICRODOLLARS_PER_MILLION=replace-me
OPENAI_IMAGE_INPUT_RATE_MICRODOLLARS_PER_MILLION=replace-me
OPENAI_IMAGE_OUTPUT_RATE_MICRODOLLARS_PER_MILLION=replace-me
